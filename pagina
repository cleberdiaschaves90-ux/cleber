<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meu Blog Tech</title>
    <!-- Vinculação do arquivo CSS externo -->
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <header>
      <h1>Meu Blog Tech</h1>
      <p>Vou compartilhar conhecimentos sobre tecnologia e programação</p>
    </header>

    <main>
      <section class="post">
        <img src="https://recreio.com.br/wp-content/uploads/2024/05/goku_capa-1.jpg" alt="Imagem de destaque do post" style="width: 100%; height: auto" />
        <h2>Meu primeiro post</h2>
        <p class="autor">Por: Cleber Dias Chaves</p>
        <p>
          Boas-vindas ao meu novo blog! Aqui vou compartilhar dicas de programação e curiosidades na área de tecnologia.
        </p>
        <!-- Botões de reação limpos e corrigidos -->
        <button class="botao-reacao">😀 <span>0</span></button>
        <button class="botao-reacao">❤️ <span>0</span></button>
      </section>
    </main>

    <script>
      const botoes = document.querySelectorAll(".botao-reacao");
      botoes.forEach((botao) => {
        botao.addEventListener("click", function () {
          console.log("Fui clicado!");
          let texto = botao.querySelector("span");
          texto.textContent = parseInt(texto.textContent) + 1;
        });
      });
    </script>
  </body>
</html>
